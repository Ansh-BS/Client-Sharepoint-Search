SECRET_KEY=replace-with-long-random-string
STAFF_PASSWORD=replace-me
# Comma-separated. Everyone listed shares ADMIN_PASSWORD but signs in
# under their own name, which is what the server log records.
ADMIN_USERNAMES=first-admin,second-admin,third-admin
ADMIN_PASSWORD=replace-me-with-something-different
# SESSION_COOKIE_SECURE=false  # only for non-HTTPS testing; defaults to true
# Set to 1 ONLY where a reverse proxy really sits in front (PythonAnywhere
# always does). It makes the app read the caller's address from the proxy's
# X-Real-IP / X-Forwarded-For headers instead of the connecting peer, which is
# what the rate limiter keys on and what the admin audit log records. Leave it
# off for a directly-exposed or local run: there the headers are caller-supplied
# and trusting them would let anyone bypass the rate limiter.
# TRUST_PROXY=1
