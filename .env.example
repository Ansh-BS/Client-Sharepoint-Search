SECRET_KEY=replace-with-long-random-string
STAFF_PASSWORD=replace-me
# Comma-separated. Everyone listed shares ADMIN_PASSWORD but signs in
# under their own name, which is what the server log records.
ADMIN_USERNAMES=first-admin,second-admin,third-admin
ADMIN_PASSWORD=replace-me-with-something-different
# SESSION_COOKIE_SECURE=false  # only for non-HTTPS testing; defaults to true
# Whether to believe the proxy headers naming the real caller — the address the
# rate limiter keys on and the audit log records. Leave this out: the default,
# "auto", works out the answer per request from who connected, and is right both
# behind PythonAnywhere's load balancer and on a directly-exposed run.
# Set TRUST_PROXY=0 only if you ever run this reachable directly by the people
# using it, e.g. an office LAN machine with no proxy in front.
# TRUST_PROXY=0
